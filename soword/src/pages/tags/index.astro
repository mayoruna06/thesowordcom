---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';
import { collectTagStats, tagHref } from '../../tags';

const base = import.meta.env.BASE_URL;
const works = await getCollection('works', ({ data }) => data.status !== 'draft');
const allTags = collectTagStats(works.map(work => work.data));
---

<BaseLayout title="標籤分類">
  <Header slot="header" />
  <Footer slot="footer" />

  <main class="container tag-index">
    <nav class="breadcrumb" aria-label="麵包屑"><a href={base}>首頁</a><span aria-hidden="true">／</span><span>標籤分類</span></nav>
    <header class="tag-index-heading">
      <p class="section-kicker">閱讀分類</p>
      <h1>查看標籤分類</h1>
      <p>依照題材與閱讀口味，找到下一本想讀的作品。</p>
    </header>
    <section class="tag-index-cloud" aria-labelledby="tag-index-title">
      <h2 id="tag-index-title">全部標籤</h2>
      <div class="tag-cloud">
        {allTags.map(tag => (
          <a class="tag" href={tagHref(base, tag.key)}><span>{tag.label}</span><span class="tag-count">{tag.count}</span></a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tag-index { max-width: 900px; padding-top: 56px; padding-bottom: 96px; }
  .breadcrumb { display: flex; gap: 10px; color: var(--ink3); font-size: 13px; }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .tag-index-heading { margin: 58px 0 34px; }
  .tag-index-heading h1 { margin: 0; color: var(--bluegray); font-size: clamp(30px, 5vw, 46px); }
  .tag-index-heading p:last-child { margin-top: 14px; color: var(--ink3); }
  .tag-index-cloud { padding: 28px; border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.72); box-shadow: 0 12px 28px rgba(29,125,111,.06); }
  .tag-index-cloud h2 { margin: 0 0 18px; color: var(--bluegray); font-size: 18px; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 10px; }
  .tag { padding: 9px 13px; color: var(--accent); background: var(--tag-bg); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 13px; }
  .tag:hover { border-color: var(--accent); background: var(--white); }
  .tag-count { margin-left: 5px; color: var(--ink3); font-size: 10px; }
</style>
