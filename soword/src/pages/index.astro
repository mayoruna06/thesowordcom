---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WorkCard from '@components/WorkCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allWorks = await getCollection('works', ({ data }) => data.status !== 'draft');
const allChapters = await getCollection('chapters');
const chapterCountByWork = allChapters.reduce<Record<string, number>>((acc, ch) => { acc[ch.data.work] = (acc[ch.data.work] ?? 0) + 1; return acc; }, {});
const latestDate = (w: typeof allWorks[0]) => w.data.updatedAt ?? w.data.publishedAt;
const isNew = (w: typeof allWorks[0]) => latestDate(w).getTime() > Date.now() - 30 * 86400_000;
const ongoingWorks = allWorks.filter(w => w.data.status === 'ongoing' || w.data.status === 'hiatus');
const completedWorks = allWorks.filter(w => w.data.status === 'completed');
const latestWorks = [...allWorks].sort((a, b) => latestDate(b).getTime() - latestDate(a).getTime()).slice(0, 4);
const randomWorkUrls = allWorks.map(work => `${base}works/${work.slug}/`);
---

<BaseLayout title="小書樓">
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="home-hero" aria-labelledby="home-title">
    <img class="hero-side-art hero-side-left" src={`${base}images/hero-main-left-extension.png`} alt="" aria-hidden="true" />
    <img class="hero-side-art hero-side-right" src={`${base}images/hero-main-right-extension.png`} alt="" aria-hidden="true" />
    <div class="home-hero-inner container">
      <div class="hero-copy">
        <h1 id="home-title">下個世界，可能，也許在這裡</h1>
        <p class="hero-lead">在小書樓，收藏正在發生的故事，也慢慢找到屬於你的下一本小說。</p>
        <div class="hero-actions">          <a class="hero-primary hero-action-card" id="random-work" data-work-urls={JSON.stringify(randomWorkUrls)} href={randomWorkUrls[0] ?? `${base}search/`}><img class="hero-action-art" src={`${base}images/action-random-book.png`} alt="" aria-hidden="true" /><span class="hero-action-copy"><strong>隨機推薦一本書</strong></span><span class="hero-action-arrow" aria-hidden="true">↗</span></a>
          <a class="hero-secondary hero-action-card" href={`${base}tags/`}><img class="hero-action-art" src={`${base}images/action-tag-categories.png`} alt="" aria-hidden="true" /><span class="hero-action-copy"><strong>查看標籤分類</strong></span><span class="hero-action-arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-image"><img src={`${base}images/hero-jianghu-desk-night.png`} alt="江湖夜讀書桌、竹影與窗外古樓燈火" /></div>
    </div>
  </section>

  <script is:inline>
    const randomWorkLink = document.querySelector("#random-work");
    if (randomWorkLink) {
      const workUrls = JSON.parse(randomWorkLink.getAttribute("data-work-urls") || "[]");
      randomWorkLink.addEventListener("click", () => {
        if (workUrls.length > 0) randomWorkLink.setAttribute("href", workUrls[Math.floor(Math.random() * workUrls.length)]);
      });
    }
  </script>

  <main class="container home-content">
    <section class="section-block" id="latest" aria-labelledby="latest-title">
      <div class="section-heading"><h2 id="latest-title">最新更新</h2></div>
      <div class="novel-grid">{latestWorks.map(w => <WorkCard work={w} chapterCount={chapterCountByWork[w.slug] ?? 0} isNew={isNew(w)} />)}</div>
    </section>


    <section class="section-block" id="all-works" aria-labelledby="all-works-title">
      <div class="section-heading"><div><h2 id="all-works-title">作品書架</h2></div></div>
      <div class="library-main">
        {ongoingWorks.length > 0 && <div class="library-section"><h3>正在連載 <span>{ongoingWorks.length}</span></h3><div class="novel-grid">{ongoingWorks.map(w => <WorkCard work={w} chapterCount={chapterCountByWork[w.slug] ?? 0} isNew={isNew(w)} />)}</div></div>}
        {completedWorks.length > 0 && <div class="library-section"><h3>已經完結 <span>{completedWorks.length}</span></h3><div class="novel-grid">{completedWorks.map(w => <WorkCard work={w} chapterCount={chapterCountByWork[w.slug] ?? 0} />)}</div></div>}
      </div>
    </section>

  </main>
</BaseLayout>
